        {[
          { screen: 'games' as Screen, bg: '#355FC7', emoji: '🧩', title: 'Games Portal', sub: 'Memory & brain exercises', tag: '▶ Play Now', tagBg: 'rgba(241,227,164,0.25)', tagColor: '#F1E3A4' },
          { screen: 'family' as Screen, bg: '#EFE0C8', emoji: '👨‍👩‍👧', title: 'Family Portal', sub: 'Caregiver dashboard & data', tag: '🔒 Secure Login', tagBg: 'rgba(74,124,89,0.15)', tagColor: '#4A7C59', dark: true },
          { screen: 'care' as Screen, bg: '#FBF8F0', emoji: '🤖', title: 'Dementia Care', sub: 'AI assistant & care guides', tag: '🎙 Ask Assistant', tagBg: 'rgba(196,98,45,0.12)', tagColor: '#C4622D', dark: true, border: '#E8D5B8' },
        ].map((item) => (
