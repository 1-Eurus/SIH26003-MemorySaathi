]

// ─── Icons ────────────────────────────────────────────────────────────────────

function MicIcon({ size = 28 }: { size?: number }) {
  return (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none">
      <rect x="9" y="2" width="6" height="12" rx="3" fill="currentColor" />
      <path d="M5 10a7 7 0 0 0 14 0" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" fill="none" />
      <line x1="12" y1="17" x2="12" y2="21" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" />
      <line x1="8" y1="21" x2="16" y2="21" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" />
    </svg>
  )
}

function BackIcon() {
  return (
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  )
}

function ChevronRight() {
  return (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
      <polyline points="9 18 15 12 9 6" />
    </svg>
  )
}

// ─── Voice Button ─────────────────────────────────────────────────────────────

function VoiceButton({ active, onToggle, size = 64 }: { active: boolean; onToggle: () => void; size?: number }) {
  return (
    <button
      onClick={onToggle}
      className="relative flex shrink-0 items-center justify-center rounded-full shadow-lg transition-all duration-300"
      style={{
        width: size, height: size,
        background: active ? '#355FC7' : '#1D2B49',
        transform: active ? 'scale(1.08)' : 'scale(1)',
      }}
      aria-label="Voice Assistant"
    >
      {active && <span className="mic-pulse" />}
      <span className="text-white"><MicIcon size={size * 0.38} /></span>
    </button>
  )
}

// ─── Screen Header ────────────────────────────────────────────────────────────

function ScreenHeader({
  title, subtitle, bg, onBack, micActive, onMicToggle,
}: {
  title: string; subtitle?: string; bg: string;
  onBack?: () => void; micActive: boolean; onMicToggle: () => void;
}) {
  return (
    <div className="shrink-0 px-5 pb-5 pt-10" style={{ background: bg }}>
      <div className="flex items-start justify-between">
        <div className="flex items-center gap-3">
          {onBack && (
            <button onClick={onBack} className="flex h-10 w-10 items-center justify-center rounded-xl" style={{ background: 'rgba(255,255,255,0.15)', color: '#fff' }}>
              <BackIcon />
            </button>
          )}
          <div>
            {subtitle && <p className="mb-0.5 text-xs font-bold uppercase tracking-widest" style={{ color: 'rgba(241,227,164,0.8)', fontFamily: 'DM Sans, sans-serif' }}>{subtitle}</p>}
            <h1 className="text-2xl font-extrabold leading-tight" style={{ color: '#FBF8F0' }}>{title}</h1>
          </div>
        </div>
        <VoiceButton active={micActive} onToggle={onMicToggle} />
      </div>
    </div>
  )
}

// ─── PIN Verification Screen ───────────────────────────────────────────────────

function PinVerificationScreen({
  onSuccess,
  onBack,
  patientName
}: {
  onSuccess: () => void;
  onBack: () => void;
  patientName: string;
}) {
  const [enteredPin, setEnteredPin] = useState('');
  const [error, setError] = useState('');

  const handlePinSubmit = () => {
    // In a real app, you would verify against the stored PIN
    // For this demo, we'll just check if it's 4 digits
    if (enteredPin.length === 4) {
      onSuccess();
    } else {
      setError('Please enter a valid 4-digit PIN');
    }
  };

  return (
    <div className="flex h-full flex-col" style={{ background: '#FBF8F0' }}>
      <ScreenHeader
        title="Family Portal Access"
        subtitle="Secure Login"
        bg="#4A7C59"
        onBack={onBack}
        micActive={false}
        onMicToggle={() => {}}
      />

      <div className="flex flex-1 flex-col items-center justify-center px-5">
        <div className="w-full max-w-md rounded-3xl bg-white p-6 shadow-lg" style={{ border: '1.5px solid #E8D5B8' }}>
          <div className="mb-6 text-center">
            <span className="text-4xl">🔒</span>
            <h2 className="mt-2 text-xl font-bold text-[#1D2B49]">Enter Your PIN</h2>
            <p className="mt-1 text-sm text-[#7A6A5A]">Please enter your 4-digit PIN to access {patientName}'s family portal</p>
          </div>

          <div className="mb-4 flex justify-center gap-3">
            {[0, 1, 2, 3].map((index) => (
              <div
                key={index}
                className="flex h-12 w-12 items-center justify-center rounded-xl border-2 text-xl font-bold"
                style={{
                  borderColor: enteredPin.length > index ? '#4A7C59' : '#E8D5B8',
                  background: enteredPin.length > index ? '#EBF5EE' : 'transparent',
                  color: '#1D2B49'
                }}
              >
                {enteredPin[index] || ''}
              </div>
            ))}
          </div>

          {error && (
            <p className="mb-4 text-center text-sm font-bold text-[#C4622D]">{error}</p>
          )}

          <div className="mb-6 grid grid-cols-3 gap-3">
            {[1, 2, 3, 4, 5, 6, 7, 8, 9, '', 0].map((num) => (
              <button
                key={num}
                onClick={() => {
                  if (enteredPin.length < 4) {
                    setEnteredPin(prev => prev + num);
                    setError('');
                  }
                }}
                className="rounded-xl py-4 text-2xl font-bold transition active:scale-95"
                style={{
                  background: '#EFE0C8',
                  color: '#1D2B49',
                  border: '1.5px solid #D4C47A'
                }}
              >
                {num}
              </button>
            ))}
            <button
              onClick={() => setEnteredPin(prev => prev.slice(0, -1))}
              className="rounded-xl py-4 text-2xl font-bold transition active:scale-95"
              style={{
                background: '#EFE0C8',
                color: '#1D2B49',
                border: '1.5px solid #D4C47A'
              }}
            >
              ⌫
            </button>
          </div>

          <button
            onClick={handlePinSubmit}
            className="w-full rounded-xl py-4 text-lg font-bold transition active:scale-95"
            style={{
              background: enteredPin.length === 4 ? '#355FC7' : '#E8D5B8',
              color: enteredPin.length === 4 ? '#FBF8F0' : '#7A6A5A'
            }}
            disabled={enteredPin.length !== 4}
          >
            Verify PIN
          </button>
        </div>
      </div>
    </div>
  );
}

