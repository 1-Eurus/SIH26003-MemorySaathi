                {['🎵 Audio prompts', '🗣 Local language', '✨ Animations'].map(f => (
                  <span key={f} className="rounded-full px-2 py-1 text-xs font-semibold" style={{ background: 'rgba(255,255,255,0.12)', color: '#FBF8F0', fontFamily: 'DM Sans, sans-serif' }}>{f}</span>
                ))}
